NODE_ENV=development
PORT=3000
APP_NAME={{projectName}}
APP_URL=http://localhost:3000

{{#eq database "postgres"}}
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME={{projectName}}_db
{{#eq orm "prisma"}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{projectName}}_db
{{/eq}}
{{/eq}}
{{#eq database "mongodb"}}
MONGO_URI=mongodb://localhost:27017/{{projectName}}
{{/eq}}
{{#eq database "supabase"}}
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
{{/eq}}
{{#or (eq auth "jwt") (eq auth "jwt-refresh")}}
JWT_SECRET=change_me_to_a_64_char_random_hex_string
JWT_EXPIRES_IN=15m
{{/or}}
{{#eq auth "jwt-refresh"}}
JWT_REFRESH_SECRET=change_me_to_another_64_char_random_hex_string
JWT_REFRESH_EXPIRES_IN=7d
{{/eq}}
{{#eq auth "api-key"}}
API_KEY=change_me_to_a_strong_random_api_key
{{/eq}}
BCRYPT_ROUNDS=12
{{#or (eq cache "redis") (eq queue "bullmq")}}
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
{{/or}}
{{#eq mailer "nodemailer"}}
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
MAIL_FROM={{projectName}} <no-reply@example.com>
{{/eq}}
{{#eq mailer "resend"}}
RESEND_API_KEY=re_<your-api-key>
MAIL_FROM={{projectName}} <no-reply@example.com>
{{/eq}}
{{#eq storage "s3"}}
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<iam-access-key-id>
AWS_SECRET_ACCESS_KEY=<iam-secret-access-key>
S3_BUCKET=<bucket-name>
{{/eq}}
{{#eq storage "cloudinary"}}
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
{{/eq}}
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
CORS_ORIGINS=http://localhost:3000
