{
  "name": "{{projectName}}",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">={{nodeVersion}}.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",{{#eq queue "bullmq"}}
    "start:worker": "node dist/worker",{{/eq}}
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",{{#eq testing "unit-e2e"}}
    "test:e2e": "jest --config ./test/jest-e2e.json",{{/eq}}{{#eq orm "typeorm"}}
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/typeorm.config.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/typeorm.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/typeorm.config.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeders/seed.ts",{{/eq}}{{#eq orm "prisma"}}
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",{{/eq}}{{#eq orm "drizzle"}}
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:studio": "drizzle-kit studio",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeders/seed.ts",{{/eq}}
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/throttler": "^6.3.0",
    "axios": "^1.7.9",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "joi": "^17.13.3",
    "winston": "^3.17.0",
    "nest-winston": "^1.10.2",
    "uuid": "^11.0.3",{{#or (eq cache "redis") (eq queue "bullmq")}}
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "ioredis": "^5.4.2",
    "@nestjs/cache-manager": "^2.3.0",
    "cache-manager": "^5.7.6",
    "cache-manager-ioredis-yet": "^2.1.0",{{/or}}{{#eq queue "bullmq"}}
    "@nestjs/bullmq": "^10.2.3",
    "bullmq": "^5.34.8",{{/eq}}{{#or (eq auth "jwt") (eq auth "jwt-refresh")}}
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "bcryptjs": "^2.4.3",{{/or}}{{#eq auth "api-key"}}
    "@nestjs/passport": "^10.0.3",
    "passport": "^0.7.0",
    "passport-headerapikey": "^1.2.2",{{/eq}}{{#if oauthProviders.length}}
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",{{/if}}{{#isTrue twoFactor}}
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",{{/isTrue}}{{#isTrue stripe}}
    "stripe": "^17.7.0",{{/isTrue}}{{#isTrue fcm}}
    "firebase-admin": "^12.7.0",{{/isTrue}}{{#isTrue sms}}
    "twilio": "^5.4.5",{{/isTrue}}{{#eq orm "typeorm"}}
    "@nestjs/typeorm": "^10.0.2",
    "typeorm": "^0.3.20",
    "dotenv": "^16.4.7",{{/eq}}{{#eq orm "prisma"}}
    "@prisma/client": "^6.5.0",{{/eq}}{{#eq orm "drizzle"}}
    "drizzle-orm": "^0.40.0",
    "dotenv": "^16.4.7",{{/eq}}{{#eq orm "mongoose"}}
    "@nestjs/mongoose": "^10.1.0",
    "mongoose": "^8.9.5",{{/eq}}{{#eq database "postgres"}}
    "pg": "^8.13.3",{{/eq}}{{#eq database "supabase"}}
    "@supabase/supabase-js": "^2.47.3",
    "pg": "^8.13.3",{{/eq}}{{#eq mailer "nodemailer"}}
    "@nestjs-modules/mailer": "^2.0.2",
    "nodemailer": "^6.9.16",{{#eq emailTemplate "handlebars"}}
    "handlebars": "^4.7.8",{{/eq}}{{#eq emailTemplate "ejs"}}
    "ejs": "^3.1.10",{{/eq}}{{/eq}}{{#eq mailer "resend"}}
    "@nestjs-modules/mailer": "^2.0.2",
    "resend": "^4.1.2",{{#eq emailTemplate "handlebars"}}
    "handlebars": "^4.7.8",{{/eq}}{{#eq emailTemplate "ejs"}}
    "ejs": "^3.1.10",{{/eq}}{{/eq}}{{#eq storage "s3"}}
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "multer": "^1.4.5-lts.1",
    "@types/multer": "^1.4.12",{{/eq}}{{#eq storage "cloudinary"}}
    "cloudinary": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "@types/multer": "^1.4.12",{{/eq}}{{#eq docs "swagger-scalar"}}
    "@scalar/nestjs-api-reference": "^0.4.0",{{/eq}}{{#isTrue socket}}
    "@nestjs/websockets": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "socket.io": "^4.8.1",{{/isTrue}}
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^{{nodeVersion}}.0.0",
    "@types/compression": "^1.7.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",{{#ne testing "none"}}
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.2.6",{{/ne}}{{#eq testing "unit-e2e"}}
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",{{/eq}}{{#eq orm "prisma"}}
    "prisma": "^6.5.0",{{/eq}}{{#eq orm "drizzle"}}
    "drizzle-kit": "^0.30.4",
    "@types/pg": "^8.11.11",{{/eq}}{{#eq emailTemplate "ejs"}}
    "@types/ejs": "^3.1.5",{{/eq}}{{#if oauthProviders.length}}
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-github2": "^1.2.6",{{/if}}{{#isTrue twoFactor}}
    "@types/qrcode": "^1.5.5",{{/isTrue}}
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@interfaces/(.*)$": "<rootDir>/interfaces/$1"
    }
  },
  "lint-staged": {
    "*.ts": ["eslint --fix", "prettier --write"]
  }{{#eq orm "prisma"}},
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  }{{/eq}}
}
