import { Controller, Get, Patch, Delete, Body, HttpCode, HttpStatus, UseGuards } from '@nestjs/common';
import { ApiTags, ApiBearerAuth, ApiOperation } from '@nestjs/swagger';
import { UserService } from './user.service';
import { UpdateUserDto } from './dto/update-user.dto';
import { CurrentUser } from '@common/decorators/current-user.decorator';
import { ok } from '@common/helpers/response.helper';
{{#ne auth "none"}}
import { JwtAuthGuard } from '@modules/auth/guards/jwt-auth.guard';
{{/ne}}

@ApiTags('Users')
{{#ne auth "none"}}
@ApiBearerAuth()
@UseGuards(JwtAuthGuard)
{{/ne}}
@Controller('users')
export class UserController {
  constructor(private readonly userService: UserService) {}

  @Get('me')
  @ApiOperation({ summary: 'Get current user profile' })
  async getMe(@CurrentUser() user: { id: string }) {
    const data = await this.userService.findById(user.id);
    return ok('Profile fetched', data);
  }

  @Patch('me')
  @ApiOperation({ summary: 'Update current user profile' })
  async updateMe(@CurrentUser() user: { id: string }, @Body() dto: UpdateUserDto) {
    const data = await this.userService.update(user.id, dto);
    return ok('Profile updated', data);
  }

  @Delete('me')
  @HttpCode(HttpStatus.OK)
  @ApiOperation({ summary: 'Delete current user account' })
  async deleteMe(@CurrentUser() user: { id: string }) {
    await this.userService.remove(user.id);
    return ok('Account deleted', null);
  }
}
