import { Module } from '@nestjs/common';
{{#or (eq auth "jwt") (eq auth "jwt-refresh")}}
import { JwtModule } from '@nestjs/jwt';
{{/or}}
import { PassportModule } from '@nestjs/passport';
import { ConfigService } from '@nestjs/config';
import { APP_GUARD } from '@nestjs/core';
import { AuthService } from './auth.service';
import { AuthController } from './auth.controller';
import { JwtStrategy } from './strategies/jwt.strategy';
{{#eq auth "jwt-refresh"}}
import { JwtRefreshStrategy } from './strategies/jwt-refresh.strategy';
{{/eq}}
import { JwtAuthGuard } from './guards/jwt-auth.guard';
import { UserModule } from '@modules/user/user.module';
{{#ne mailer "none"}}
import { MailerModule } from '@infrastructure/mail/mailer.module';
{{/ne}}
{{#if oauthProviders.length}}
import { OAuthController } from './oauth.controller';
{{#includes oauthProviders "google"}}
import { GoogleStrategy } from './strategies/google.strategy';
{{/includes}}
{{#includes oauthProviders "github"}}
import { GithubStrategy } from './strategies/github.strategy';
{{/includes}}
{{/if}}
{{#isTrue rbac}}
import { RolesGuard } from '@common/guards/roles.guard';
{{/isTrue}}
{{#isTrue twoFactor}}
import { TwoFactorService } from './two-factor.service';
import { TwoFactorController } from './two-factor.controller';
{{/isTrue}}

@Module({
  imports: [
    UserModule,
    PassportModule,
    {{#ne mailer "none"}}
    MailerModule,
    {{/ne}}
    {{#or (eq auth "jwt") (eq auth "jwt-refresh")}}
    JwtModule.registerAsync({
      inject: [ConfigService],
      useFactory: (config: ConfigService) => ({
        secret: config.get<string>('JWT_SECRET'),
        signOptions: { expiresIn: config.get<string>('JWT_EXPIRES_IN') ?? '15m' },
      }),
    }),
    {{/or}}
  ],
  controllers: [
    AuthController,
    {{#if oauthProviders.length}}
    OAuthController,
    {{/if}}
    {{#isTrue twoFactor}}
    TwoFactorController,
    {{/isTrue}}
  ],
  providers: [
    AuthService,
    JwtStrategy,
    {{#eq auth "jwt-refresh"}}
    JwtRefreshStrategy,
    {{/eq}}
    {{#includes oauthProviders "google"}}
    GoogleStrategy,
    {{/includes}}
    {{#includes oauthProviders "github"}}
    GithubStrategy,
    {{/includes}}
    {{#isTrue twoFactor}}
    TwoFactorService,
    {{/isTrue}}
    { provide: APP_GUARD, useClass: JwtAuthGuard },
    {{#isTrue rbac}}
    { provide: APP_GUARD, useClass: RolesGuard },
    {{/isTrue}}
  ],
  exports: [AuthService{{#isTrue twoFactor}}, TwoFactorService{{/isTrue}}],
})
export class AuthModule {}
